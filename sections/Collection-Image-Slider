  //     currentIndex = (currentIndex + 1) % cards.length;  // Scrolling down (right swipe)
  //   } else {
  //     currentIndex = (currentIndex - 1 + cards.length) % cards.length;  // Scrolling up (left swipe)
  //   }
  //   updateCards();
  // });

  // updateCards();
</script>

<!-- Section Schema for Shopify Customization -->
{% schema %}
{
  "name": "Scrollable Card Loop",
  "settings": [],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "label": "Card Image",
          "id": "card_image",
          "info": "Upload an image for the card."
        },
        {
          "type": "text",
          "label": "Card Title",
          "id": "card_title",
          "default": "Card Title",
          "info": "Enter the title for the card."
        },
        {
          "type": "textarea",
          "label": "Card Description",
          "id": "card_description",
          "default": "Card Description",
          "info": "Enter a description for the card."
        },
        {
          "type": "url",
          "id": "img_link",
          "label": "Img Link",
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "custom-circle-slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
